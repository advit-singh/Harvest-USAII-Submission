# Supabase (required for production auth)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Database (required for backend intelligence layer)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/harvest

# OpenRouter (required for AI extraction; free tier)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# API configuration
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_USE_MOCK_API=true
# Enable live Person A intelligence APIs (forecasts, recommendations, simulations, uploads) while keeping other workspaces on mocks
NEXT_PUBLIC_LIVE_INTELLIGENCE_API=true

# External data (free, no API keys) — used when organization forecast.externalDataEnabled is true
# Weather: Open-Meteo https://open-meteo.com
# Holidays: Nager.Date https://date.nager.at
